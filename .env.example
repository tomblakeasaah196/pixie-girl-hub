# ============================================================
# PIXIE GIRL HUB — BACKEND ENVIRONMENT VARIABLES
# Copy to .env and fill in real values. NEVER commit .env to git.
# ============================================================

# ── App ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=7000
APP_NAME=pixiegirl-hub-backend
APP_URL=http://localhost:7000
LOG_LEVEL=info
# Read-side RLS is ON by default (defence-in-depth for entity isolation).
# Set false to fall back to app-layer-only scoping without a deploy.
RLS_READ_ENFORCE=true

# ── PostgreSQL ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xxxxxxxxx
DB_USER=xxxxxxxxxxx
DB_PASSWORD=xxxxxxxx
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SSL=false
DB_STATEMENT_TIMEOUT_MS=30000

# ── Redis (cache, sessions, BullMQ queue) ───────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Authentication ──────────────────────────────────────────
JWT_SECRET=long_string_random
JWT_ACCESS_EXPIRES_IN=45m
JWT_REFRESH_EXPIRES_IN=14d
SESSION_SECRET=another_long_string_random
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# ── Encryption (AES-256 for credentials at rest) ────────────
# MUST be exactly 32 bytes hex-encoded (64 hex chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=long_string_random

# ── Password reset ──────────────────────────────────────────
# Lifetime (minutes) of a password-reset link. Single-use; stored only as a
# SHA-256 hash in Redis.
PASSWORD_RESET_TTL_MIN=30

# ── Identity cache ─────────────────────────────────────────────
# TTL (seconds) for the cached per-request user / brand-config / permission
# lookups. Domain events invalidate eagerly; the TTL is the staleness
# backstop. 0 disables the cache (every request hits the DB directly).
IDENTITY_CACHE_TTL_S=30

# ── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
TRUSTED_PROXIES=loopback,linklocal,uniquelocal

# ── Rate limiting (public / unauthenticated write endpoints) ─
# Per-IP throttle for checkout, newsletter signup, hair-quiz, e-sign submit —
# blunts enumeration/abuse on writes that create records.
PUBLIC_WRITE_RATE_WINDOW_MS=900000   # window length in ms (900000 = 15 min)
PUBLIC_WRITE_RATE_MAX=20             # max requests per IP per window

# ── Storage (self-hosted media per V2.2 spec) ───────────────
STORAGE_KIND=local
STORAGE_LOCAL_ROOT=./media
CDN_BASE_URL=
MEDIA_MAX_FILE_SIZE_MB=200

# ── FFmpeg ──────────────────────────────────────────────────
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# ── Payment Gateways ────────────────────────────────────────
# Implementation status (2026-06-14): all 4 implemented (service + webhook
# verify + confirm → resolves in Sales). Each is env-gated: blank keys → that
# gateway's calls return a clean 503 and its webhooks log-only.
#   Paystack — initialize / verify / charge-authorization; HMAC-SHA512 webhook.
#   OPay     — Cashier initialize / status verify; HMAC-SHA512 webhook.
#   Nomba    — OAuth + checkout initialize / verify; HMAC-SHA256 webhook.
#   Stripe   — Checkout Session + retrieve; constructEvent webhook (raw body).
# Confirm handlers resolve brand+order_id from transaction metadata, re-verify
# server-side, and record idempotently. Each confirmed payment captures the
# per-gateway fee from business_config.payment_gateway_fees and books it to the
# gateway's 551x GL account (§6.6); Stripe captures paid_currency/amount/fx for
# realised-FX. Stripe requires metadata.amount_ngn.
# (Payment INITIATION at checkout — choosing a gateway — is the front-end's job;
#  these are the gateway clients + the inbound confirmation pipeline.)
# Paystack (NGN) — ✅
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# OPay (NGN) — ✅  (Cashier API)
OPAY_PUBLIC_KEY=
OPAY_PRIVATE_KEY=
OPAY_MERCHANT_ID=
OPAY_BASE_URL=https://liveapi.opaycheckout.com

# Nomba (NGN, online + POS) — ✅  (OAuth client-credentials)
NOMBA_BASE_URL=https://api.nomba.com
# Faitlyn hair
FAITLYN_NOMBA_CLIENT_ID=
FAITLYN_NOMBA_API_KEY=
FAITLYN_NOMBA_ACCOUNT_ID=
# Pixie girl
PIXIE_NOMBA_CLIENT_ID=
PIXIE_NOMBA_API_KEY=
PIXIE_NOMBA_ACCOUNT_ID=
# Nomba WEBHOOK SIGNATURE KEY — a SEPARATE secret you set in the Nomba dashboard
# (Developer → Webhook Setup), NOT the API client secret. Used only to VERIFY
# inbound webhooks. Generate with: openssl rand -hex 32  (paste the same value
# into the dashboard AND here). Unprefixed = legacy fallback; per-brand overrides
# mirror the API keys above.
NOMBA_WEBHOOK_SIG_KEY=
PIXIE_NOMBA_WEBHOOK_SIG_KEY=
FAITLYN_NOMBA_WEBHOOK_SIG_KEY=

# Stripe (international) — ✅
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Active gateways in THIS deployment (comma list). OPay + Stripe stay fully
# implemented but disabled by default — add them here if a project needs them.
ENABLED_PAYMENT_GATEWAYS=paystack,nomba

# ── Logistics ───────────────────────────────────────────────
CHOWDECK_API_KEY=
GIGL_API_KEY=
DHL_API_KEY=                          # international / cross-border (not yet wired)

# ── Communication ───────────────────────────────────────────
# Meta WhatsApp Cloud API
META_WA_PHONE_ID=
META_WA_TOKEN=
META_WA_VERIFY_TOKEN=
# Instagram Graph API
META_IG_ACCESS_TOKEN=
META_GRAPH_VERIFY_TOKEN=

# ── Social posting (V2.2 §6.14) ─────────────────────────────
# Status (2026-06-14): outbound publishing implemented for all 4 platforms
# (Instagram, Facebook, TikTok, YouTube) via src/services/social-publisher.
# Each is env-gated: blank creds → that platform's publish/metrics return a
# clean 503 and the post is marked 'failed'. One account per platform.
#   instagram → Meta Graph: media container → media_publish (image/reel)
#   facebook  → Meta Graph Page: /photos | /videos | /feed
#   tiktok    → Content Posting API (PULL_FROM_URL video init)
#   youtube   → Data API v3 videos.insert (multipart upload from media URL)
META_GRAPH_VERSION=v21.0
META_IG_USER_ID=                     # IG Business account id (publish target)
META_FB_PAGE_ID=
META_FB_PAGE_TOKEN=                  # Page access token — used for FB + IG publish
TIKTOK_ACCESS_TOKEN=
TIKTOK_BASE_URL=https://open.tiktokapis.com
YOUTUBE_ACCESS_TOKEN=               # OAuth token with youtube.upload scope
YOUTUBE_BASE_URL=https://www.googleapis.com

# ── Google Maps / Places ────────────────────────────────────
# Browser key powering address autocomplete on the public Walk-in + Online-QR
# forms. Surfaced to the admin app at runtime via GET /api/public/config, so
# setting it here (on the server) takes effect WITHOUT rebuilding the admin
# bundle. It's a public, referrer-restricted browser key.
GOOGLE_MAPS_API_KEY=

# ── Geoapify (maps + geocoding) ─────────────────────────────
# One SERVER-ONLY key (never sent to the browser) behind every map/address
# feature via src/services/geoapify.service.js + the /attendance/geo/* proxy:
#   • HR clock-in reverse geocoding — coords → a stored address label at punch
#     time (best-effort: blank = coords + "View on map" pin still work).
#   • HR office-location picker — the interactive static map + address search
#     used to set each office's geofence (blank = picker degrades to manual
#     lat/lng entry).
# Free tier is 3,000 requests/day. Restrict the key by IP in the Geoapify
# dashboard (it never leaves the server, so no HTTP-referrer restriction fits).
GEOAPIFY_API_KEY=

# SMTP (transactional email)
# MUST be a real relay in staging/production. A blank host — or localhost:25 —
# means outbound mail is silently dropped (nothing on an app host listens on
# :25, and cloud providers block outbound port 25). Use an authenticated relay:
#   Zoho/Google Workspace: smtp.zoho.com / smtp.gmail.com  · 587 · your mailbox
#   Transactional API:     SendGrid / Mailgun / Amazon SES / Resend / Postmark
# Verify it end-to-end with:  npm run smtp:doctor -- --to you@example.com
SMTP_HOST=
SMTP_PORT=587
# true → implicit TLS (port 465). Leave false for a 587 relay (STARTTLS is
# still enforced). Only a loopback dev relay (MailHog) sends plaintext.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Shared HMAC secret the Cloudflare Email Workers sign inbound payloads with
# (EMAIL_TWO_WAY_SETUP inbound webhook).
CF_EMAIL_INBOUND_SECRET=

# ── SMS (Twilio) — optional retention fallback channel ──────
# Unset → sms.service no-ops (returns "skipped"). Used by retention workflows
# when a customer has no email / WhatsApp on file.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                          # +E.164 number or a Messaging Service SID

# ── Marketing / paid ads (V2.2 §6.15 — Google Ads + Meta) ───
# Live spend sync + campaign push. App-level creds here; per-ad-account OAuth
# tokens are stored AES-encrypted on shared.ad_accounts. Blank for a network →
# its pull/push returns a clean 503 and the nightly sync skips it.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=         # MCC / manager account id (digits only), optional
GOOGLE_ADS_API_VERSION=v17
GOOGLE_ADS_BASE_URL=https://googleads.googleapis.com
GOOGLE_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
META_MARKETING_API_KEY=               # optional system-user token; per-account tokens preferred
META_ADS_APP_SECRET=                  # optional, enables appsecret_proof on Meta calls

# ── E-Commerce (WooCommerce sync) ───────────────────────────
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# ── Geolocation (MaxMind GeoLite2 local database) ───────────
# Path to the GeoLite2-Country.mmdb binary database file.
# Extract from the tar.gz supplied with the project and place here.
MAXMIND_DB_PATH=./data/GeoLite2-Country.mmdb
# Free GeoLite2 licence key — sign up at https://www.maxmind.com/en/geolite2/signup
# Required for the automated Sunday 02:00 WAT database auto-update cron.
# IP lookups work without this once the .mmdb file exists at MAXMIND_DB_PATH.
MAXMIND_LICENSE_KEY=
# MaxMind account ID (numeric string from your maxmind.com dashboard).
MAXMIND_ACCOUNT_ID=
# node-cron expression for the weekly database refresh (default: Sun 02:00 WAT).
CRON_GEOIP_DB_UPDATE=0 2 * * 0

# ── AI (per V2.2 §8.1) ──────────────────────────────────────
# DeepSeek (LLM)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Groq (Whisper transcription)
GROQ_API_KEY=
# OpenAI (embeddings only)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# AI budget enforcement
AI_MONTHLY_SOFT_CAP_NGN=75000
AI_MONTHLY_HARD_CAP_NGN=80000

# ── Speech-to-text (Whisper) — Praxis voice input (X-2) ─────
# Unset / "none" → transcription no-ops. MEDIA_BASE_URL allow-lists the origin
# audio assets may be fetched from (SSRF guard on the transcription fetch).
TRANSCRIPTION_PROVIDER=none          # none | openai | groq | <provider>
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_API_BASE_URL=
TRANSCRIPTION_MODEL=                  # e.g. whisper-1 | whisper-large-v3
MEDIA_BASE_URL=                      # e.g. https://media.pixiegirl.example

# ── Web Push (VAPID) — browser push notifications ───────────
# All three unset → push is inert. Generate a key pair:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=                          # mailto:ops@yourdomain or an https URL

# ── Observability ───────────────────────────────────────────
SENTRY_DSN=
ENABLE_REQUEST_LOGGING=true
ENABLE_AUDIT_LOG=true

# ── PDF rendering (J-7 / X-1 — headless Chromium via puppeteer) ──
PDF_ENABLED=true
PUPPETEER_SKIP_DOWNLOAD=true      # e.g. /usr/bin/chromium; blank = puppeteer's bundled Chromium
PDF_RENDER_TIMEOUT_MS=30000

# ── FX rate provider (J-3) ──────────────────────────────────
# none → fx-rates cron no-ops. exchangerate_host has a free no-key tier;
# openexchangerates / fixer require FX_API_KEY.
FX_PROVIDER=none                     # none | openexchangerates | exchangerate_host | fixer
FX_API_KEY=
FX_API_BASE_URL=
FX_BASE_CURRENCY=NGN
FX_BUFFER_PCT=0                      # 0..1 (e.g. 0.02 = +2% buffer over market)

# ── Embeddings / RAG vendor (J-8) ───────────────────────────
# none → ai-embed worker + Praxis RAG retrieval skip.
EMBEDDINGS_PROVIDER=none             # none | openai | deepseek | voyage
EMBEDDINGS_API_KEY=
EMBEDDINGS_API_BASE_URL=
EMBEDDINGS_MODEL=text-embedding-3-small

# ── Praxis live orchestrator (X-2) ──────────────────────────
# Off by default. When on AND the PRAXIS_LLM_VENDOR row is configured in AI
# Control (ai_vendor_credentials), Praxis runs live (RAG → LLM → propose action).
PRAXIS_ORCHESTRATOR_ENABLED=false
PRAXIS_LLM_VENDOR=deepseek           # which ai_vendor_credentials row backs the chat LLM
PRAXIS_RAG_TOP_K=6
PRAXIS_MAX_TOOLS=40

# ── Workers ─────────────────────────────────────────────────
ENABLE_WORKERS=true                  # run BullMQ consumers + crons in-process

# ── Feature flags ───────────────────────────────────────────
FEATURE_MANUAL_PAYMENTS_ENABLED=false
FEATURE_PRAXIS_VOICE_ENABLED=true
FEATURE_UGC_INGESTION_ENABLED=true

# ── Cron schedules (in your tz) ─────────────────────────────
TZ=Africa/Lagos
CRON_DAILY_AI_BRIEFING=0 7 * * *
CRON_WEEKLY_SALES_REPORT=0 20 * * 6
CRON_WEEKLY_CUSTOMER_REPORT=0 20 * * 6
CRON_LAYAWAY_ABANDONMENT_CHECK=0 2 * * *
CRON_FX_RATE_REFRESH=0 6 * * *
CRON_LOW_STOCK_ALERTS=0 8,14 * * *
CRON_SUBSCRIPTION_RENEWAL_REMINDERS=0 9 * * *
CRON_RETENTION_WORKFLOWS=0 3 * * *
CRON_AI_EMBEDDINGS_REFRESH=0 4 * * *
# Web Push (VAPID) — generate once with:
#   node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(JSON.stringify(k));"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@pixiegirl.com

# ── Kaizen (maintenance/ops console — kaizen.pixiegirlglobal.com) ─────────────
# All optional: the main app boots without them. The Kaizen auth path fails
# fast with a clear message if KAIZEN_JWT_SECRET is missing. Generate a secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
KAIZEN_JWT_SECRET=
KAIZEN_ACCESS_TTL=30m
KAIZEN_REFRESH_TTL_DAYS=14
KAIZEN_INVITE_TTL_HOURS=72
# Base URL of the Kaizen frontend (used to build invite links). Prod:
KAIZEN_BASE_URL=https://kaizen.pixiegirlglobal.com
# Optional cookie domain for the refresh cookie (e.g. .pixiegirlglobal.com).
# Leave unset for a host-only cookie.
KAIZEN_COOKIE_DOMAIN=
# ── Phase 1: frontend error ingest ───────────────────────────────────────────
# Shared static key the client apps send as `X-Kaizen-Ingest-Key` when POSTing
# crashes to /api/v1/kaizen/ingest/client-error. Generate:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Leave blank to DISABLE ingest (endpoint returns 503).
KAIZEN_INGEST_KEY=
# Comma-separated Origin allowlist for the ingest endpoint (browsers send Origin
# on cross-site POSTs). Example:
#   https://admin.pixiegirlglobal.com,https://pixiegirlglobal.com,https://kaizen.pixiegirlglobal.com
KAIZEN_INGEST_ALLOWED_ORIGINS=
# Capture 4xx responses as errors too (noisy — validation 400s etc.). Off by default.
KAIZEN_CAPTURE_4XX=false
# First-operator seed (used ONLY by scripts/kaizen-create-operator.js at deploy;
# never rely on committing a real password here):
KAIZEN_ADMIN_EMAIL=tom.asaah@jbspraxis.com
KAIZEN_ADMIN_NAME=Tom Asaah
KAIZEN_ADMIN_PHONE=09020868023
KAIZEN_ADMIN_PASSWORD=
